# Postgres connection string (matches the docker-compose.yml service).
DATABASE_URL=postgres://rag:rag@localhost:5432/rag?sslmode=disable
# Base URL of the natively running Ollama server (plain HTTP, no auth).
OLLAMA_URL=http://localhost:11434
# Ollama model used for embeddings; its output dimension must match EMBED_DIMS
# and the vector(1024) column in migrations/000001_init.up.sql.
EMBED_MODEL=mxbai-embed-large
# Ollama model used for answer generation.
LLM_MODEL=llama3.1:8b
# Dimensionality of the embeddings produced by EMBED_MODEL.
EMBED_DIMS=1024
# Port the HTTP API listens on.
HTTP_PORT=8080
